#!/usr/bin/env bash
set -euo pipefail

PROJECT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
CONFIG_PATH="$PROJECT_DIR/config/local.env"
SERVICE_CONFIG_PATH="$PROJECT_DIR/config/outbox-service.env"
PYTHON_BIN="$PROJECT_DIR/.venv/bin/python"

if [[ -f "$CONFIG_PATH" ]]; then
  set -a
  source "$CONFIG_PATH"
  set +a
fi
if [[ -f "$SERVICE_CONFIG_PATH" ]]; then
  set -a
  source "$SERVICE_CONFIG_PATH"
  set +a
fi

if [[ -z "${OUTBOX_DATABASE_URL:-}" && -z "${OUTBOX_DB_PASSWORD:-}" && -n "${OUTBOX_KEYCHAIN_SERVICE:-}" ]]; then
  OUTBOX_DB_PASSWORD="$(security find-generic-password -w -s "$OUTBOX_KEYCHAIN_SERVICE" -a "$OUTBOX_DB_USER" 2>/dev/null || true)"
  [[ -z "$OUTBOX_DB_PASSWORD" ]] || export OUTBOX_DB_PASSWORD
fi

if [[ -z "${OUTBOX_DATABASE_URL:-}" && -z "${OUTBOX_DB_PASSWORD:-}" ]]; then
  printf 'Missing Outbox database password or OUTBOX_DATABASE_URL.\n' >&2
  exit 2
fi

exec "$PYTHON_BIN" -m app.reaper
