# Copy to local.env or use the interactive configuration command.
# Do not put TWENTY_DB_PASSWORD in this file.
TWENTY_DB_HOST=192.168.112.72
TWENTY_DB_PORT=5432
TWENTY_DB_NAME=default
TWENTY_DB_USER=postgres
TWENTY_DB_SSLMODE=prefer
TWENTY_WORKSPACE_SCHEMA=workspace_avv74ijhm70d2bh7o1toe4anv
TWENTY_BUSINESS_TIMEZONE=Asia/Shanghai
TWENTY_EXPORT_LIMIT=5
TWENTY_OUTPUT_CHANNEL=email
HERMES_COMMAND=/Users/acelerzbw/.local/bin/inquiry-trial

# Use a separate writable PostgreSQL database or account. Do not point this at
# the read-only Twenty workspace connection.
OUTBOX_DB_HOST=192.168.112.72
OUTBOX_DB_PORT=5432
OUTBOX_DB_NAME=sales_automation
OUTBOX_DB_USER=sales_automation
OUTBOX_DB_SSLMODE=prefer
OUTBOX_KEYCHAIN_SERVICE=twenty-hermes-outbox
OUTBOX_AUTO_IMPORT=true
OUTBOX_CONSUMER_TOKENS_JSON='{"replace-email-token":["email:email"],"replace-linkedin-token":["linkedin:linkedin"]}'
OUTBOX_PRODUCER_TOKEN=replace-producer-token
OUTBOX_CONTACT_COOLDOWN_HOURS=24
OUTBOX_API_HOST=0.0.0.0
OUTBOX_API_PORT=8010

# Secondary-lead discovery, settling, classification, and event scheduling.
HERMES_SECONDARY_FULL_SCAN_HOURS=6
HERMES_SECONDARY_SETTLE_HOURS=48
HERMES_SECONDARY_SETTLE_JITTER_HOURS=24
HERMES_SECONDARY_SCAN_BATCH_SIZE=500
HERMES_CLASSIFICATION_BATCH_SIZE=20
HERMES_CLASSIFICATION_BACKLOG_DELAY_MINUTES=10
HERMES_CLASSIFICATION_MIN_CONFIDENCE=0.65
HERMES_CLASSIFICATION_TIMEOUT_SECONDS=600
HERMES_REMOTE_RETRY_MINUTES=10
# true: low-confidence classifications and generated messages wait for people.
# false: classifications continue scheduling and generated messages are auto-approved.
HERMES_HUMAN_REVIEW_ENABLED=true
HERMES_AUTO_REVIEWER=hermes-scheduler
HERMES_POLL_MAX_ATTEMPTS=3
EMAIL_CONTACT_COOLDOWN_HOURS=24
