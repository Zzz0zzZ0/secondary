#!/usr/bin/env bash
set -euo pipefail

PROJECT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
CONFIG_PATH="$PROJECT_DIR/config/local.env"
SCRIPTS_DIR="$PROJECT_DIR/scripts"
RUNS_DIR="$PROJECT_DIR/outputs/runs"
REPORTS_DIR="$PROJECT_DIR/reports"

load_config() {
  if [[ -f "$CONFIG_PATH" ]]; then
    set -a
    # This file is created and owned by the local user. It must not contain a password.
    source "$CONFIG_PATH"
    set +a
  fi
}

prompt_value() {
  local variable_name="$1"
  local prompt_text="$2"
  local default_value="$3"
  local entered_value
  read -r -p "$prompt_text [$default_value]: " entered_value
  printf -v "$variable_name" '%s' "${entered_value:-$default_value}"
}

configure() {
  local db_host db_port db_name db_user db_sslmode workspace_schema export_limit
  local outbox_host outbox_port outbox_name outbox_user outbox_sslmode
  prompt_value db_host "Twenty database host" "${TWENTY_DB_HOST:-crm-db.internal}"
  prompt_value db_port "PostgreSQL port" "${TWENTY_DB_PORT:-5432}"
  prompt_value db_name "Database name" "${TWENTY_DB_NAME:-default}"
  prompt_value db_user "Database user" "${TWENTY_DB_USER:-postgres}"
  prompt_value db_sslmode "SSL mode" "${TWENTY_DB_SSLMODE:-prefer}"
  prompt_value workspace_schema "Twenty workspace schema" "${TWENTY_WORKSPACE_SCHEMA:-workspace_replace_me}"
  prompt_value export_limit "Default record limit" "${TWENTY_EXPORT_LIMIT:-5}"
  prompt_value outbox_host "Outbox database host" "${OUTBOX_DB_HOST:-$db_host}"
  prompt_value outbox_port "Outbox PostgreSQL port" "${OUTBOX_DB_PORT:-5432}"
  prompt_value outbox_name "Outbox database name" "${OUTBOX_DB_NAME:-sales_automation}"
  prompt_value outbox_user "Outbox database user" "${OUTBOX_DB_USER:-sales_automation}"
  prompt_value outbox_sslmode "Outbox SSL mode" "${OUTBOX_DB_SSLMODE:-prefer}"

  umask 077
  {
    printf 'TWENTY_DB_HOST=%q\n' "$db_host"
    printf 'TWENTY_DB_PORT=%q\n' "$db_port"
    printf 'TWENTY_DB_NAME=%q\n' "$db_name"
    printf 'TWENTY_DB_USER=%q\n' "$db_user"
    printf 'TWENTY_DB_SSLMODE=%q\n' "$db_sslmode"
    printf 'TWENTY_WORKSPACE_SCHEMA=%q\n' "$workspace_schema"
    printf 'TWENTY_EXPORT_LIMIT=%q\n' "$export_limit"
    printf 'TWENTY_HERMES_RUNS_DIR=%q\n' "$RUNS_DIR"
    printf 'TWENTY_HERMES_REPORTS_DIR=%q\n' "$REPORTS_DIR"
    printf 'HERMES_COMMAND=%q\n' "$HOME/.local/bin/hermes"
    printf 'HERMES_SKILL_DIR=%q\n' "$PROJECT_DIR/skill/generate-secondary-lead-message"
    printf 'OUTBOX_DB_HOST=%q\n' "$outbox_host"
    printf 'OUTBOX_DB_PORT=%q\n' "$outbox_port"
    printf 'OUTBOX_DB_NAME=%q\n' "$outbox_name"
    printf 'OUTBOX_DB_USER=%q\n' "$outbox_user"
    printf 'OUTBOX_DB_SSLMODE=%q\n' "$outbox_sslmode"
    printf 'OUTBOX_KEYCHAIN_SERVICE=%q\n' "twenty-hermes-outbox"
    printf 'OUTBOX_AUTO_IMPORT=%q\n' "true"
    printf 'EMAIL_CONTACT_COOLDOWN_HOURS=%q\n' "24"
  } >"$CONFIG_PATH"
  chmod 600 "$CONFIG_PATH"
  printf 'Configuration saved to %s (database password was not stored).\n' "$CONFIG_PATH"
}

python_cli() {
  local python_bin="$PROJECT_DIR/.venv/bin/python"
  if [[ ! -x "$python_bin" ]]; then
    printf 'Python environment missing. First run option 8.\n' >&2
    return 2
  fi
  ensure_config
  (cd "$PROJECT_DIR" && "$python_bin" -m app.cli "$@")
}

prompt_outbox_password() {
  ensure_config
  if [[ -z "${OUTBOX_DATABASE_URL:-}" && -z "${OUTBOX_DB_PASSWORD:-}" && -n "${OUTBOX_KEYCHAIN_SERVICE:-}" ]]; then
    OUTBOX_DB_PASSWORD="$(security find-generic-password -w -s "$OUTBOX_KEYCHAIN_SERVICE" -a "$OUTBOX_DB_USER" 2>/dev/null || true)"
    [[ -z "$OUTBOX_DB_PASSWORD" ]] || export OUTBOX_DB_PASSWORD
  fi
  if [[ -z "${OUTBOX_DATABASE_URL:-}" && -z "${OUTBOX_DB_PASSWORD:-}" ]]; then
    read -r -s -p "Outbox database password (not stored): " OUTBOX_DB_PASSWORD
    printf '\n'
    export OUTBOX_DB_PASSWORD
  fi
}

setup_python() {
  "$SCRIPTS_DIR/setup_python.sh"
}

outbox_migrate() {
  prompt_outbox_password
  python_cli migrate
}

ensure_config() {
  load_config
  if [[ -z "${TWENTY_DB_HOST:-}" ]]; then
    printf 'No local configuration found. Starting setup.\n'
    configure
    load_config
  fi
}

prompt_password() {
  if [[ -z "${TWENTY_DB_PASSWORD:-}" ]]; then
    read -r -s -p "Database password (not stored): " TWENTY_DB_PASSWORD
    printf '\n'
    export TWENTY_DB_PASSWORD
  fi
}

latest_run() {
  local candidate latest_path=""
  for candidate in "$RUNS_DIR"/*; do
    [[ -d "$candidate" ]] || continue
    if [[ -z "$latest_path" ]] || [[ "$candidate" > "$latest_path" ]]; then
      latest_path="$candidate"
    fi
  done
  printf '%s\n' "$latest_path"
}

run_check() {
  ensure_config
  prompt_password
  "$SCRIPTS_DIR/twenty_db_check.sh"
}

run_discover() {
  ensure_config
  prompt_password
  "$SCRIPTS_DIR/twenty_db_discover.sh" "$PROJECT_DIR/outputs/twenty_db_schema_report.txt"
  "$SCRIPTS_DIR/twenty_db_business_map.sh" "$PROJECT_DIR/outputs/twenty_db_business_map.txt"
}

run_export() {
  ensure_config
  prompt_password
  "$SCRIPTS_DIR/twenty_export_hermes_inputs.sh" "$PROJECT_DIR/outputs/twenty_hermes_inputs.json"
}

compare_products() {
  ensure_config
  prompt_password
  local python_bin="$PROJECT_DIR/.venv/bin/python"
  if [[ ! -x "$python_bin" ]]; then
    printf 'Python environment missing. First run option 8.\n' >&2
    return 2
  fi
  (cd "$PROJECT_DIR" && "$python_bin" -m app.product_catalog)
}

run_pipeline() {
  ensure_config
  prompt_password
  if [[ "${OUTBOX_AUTO_IMPORT:-false}" == "true" ]]; then
    prompt_outbox_password
  fi
  "$SCRIPTS_DIR/twenty_run_hermes_pipeline.sh"
}

build_report() {
  local run_dir="${1:-$(latest_run)}"
  if [[ -z "$run_dir" ]] || [[ ! -d "$run_dir" ]]; then
    printf 'No run directory found under %s\n' "$RUNS_DIR" >&2
    exit 2
  fi
  mkdir -p "$REPORTS_DIR"
  ruby "$SCRIPTS_DIR/build_single_report.rb" "$run_dir" "$REPORTS_DIR/latest.html"
}

open_report() {
  build_report
  if command -v open >/dev/null 2>&1; then
    open "$REPORTS_DIR/latest.html"
  else
    printf 'Open this file in a browser: %s\n' "$REPORTS_DIR/latest.html"
  fi
}

menu() {
  while true; do
    printf '\nTwenty → Hermes PoC\n'
    printf '1) Configure connection\n'
    printf '2) Test database connection\n'
    printf '3) Discover CRM schema\n'
    printf '4) Export CRM records only\n'
    printf '5) Run complete CRM → Hermes pipeline\n'
    printf '6) Rebuild latest single report\n'
    printf '7) Open latest report\n'
    printf '8) Install Python dependencies\n'
    printf '9) Initialize/update Outbox database\n'
    printf '10) Compare CRM and Skill product catalogs\n'
    printf '0) Exit\n'
    read -r -p 'Select: ' menu_choice
    case "$menu_choice" in
      1) configure ;;
      2) run_check ;;
      3) run_discover ;;
      4) run_export ;;
      5) run_pipeline ;;
      6) build_report ;;
      7) open_report ;;
      8) setup_python ;;
      9) outbox_migrate ;;
      10) compare_products ;;
      0) return 0 ;;
      *) printf 'Unknown selection.\n' ;;
    esac
  done
}

mkdir -p "$RUNS_DIR" "$REPORTS_DIR"
load_config

case "${1:-menu}" in
  menu) menu ;;
  configure) configure ;;
  check) run_check ;;
  discover) run_discover ;;
  export) run_export ;;
  products) compare_products ;;
  run) run_pipeline ;;
  report) build_report "${2:-}" ;;
  open) open_report ;;
  setup) setup_python ;;
  migrate) outbox_migrate ;;
  *)
    printf 'Usage: %s [menu|configure|check|discover|export|products|run|report [RUN_DIR]|open|setup|migrate]\n' "$0" >&2
    exit 2
    ;;
esac
